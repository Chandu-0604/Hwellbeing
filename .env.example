HANA_HOST=your_hana_host
HANA_PORT=443
HANA_USER=DBADMIN
HANA_PASSWORD=your_password
HANA_SCHEMA=your_schema

DB_POOL_SIZE=5

ALLOWED_ORIGINS=https://your-frontend-domain.com

GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key

# -----------------------------

# JWT CONFIG

